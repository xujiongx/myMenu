# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# 仅服务端 — 禁止 NEXT_PUBLIC_ 前缀，勿提交真实值
# 业务读写依赖 Service Role（绕过 RLS）
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# 会话 JWT 签名（建议独立随机串；未配置时回退到 SERVICE_ROLE / PUBLISHABLE）
SESSION_SECRET=replace_with_long_random_string

# ImgBB 菜品图上传 — 仅服务端
IMG_BB_API_KEY=your_imgbb_api_key

# 健康检查接口鉴权（防止 Supabase 免费项目因长期不活跃被暂停）
# 值自取强随机字符串，与 GitHub Actions Secret HEALTH_CHECK_SECRET 保持一致
# HEALTH_CHECK_SECRET=your-random-secret-here
